{
  "type": "module",
  "name": "uxiu-template-default",
  "version": "3.0.1",
  "description": "默认模板",
  "main": "./dist/index.js",
  "scripts": {
    "start": "tsx ./src/index.ts",
    "start:dist": "cd dist && node --run start",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/index.ts",
    "debug": "cross-env NODE_ENV=development tsx watch --inspect ./src/index.ts",
    "build": "uxiu-cli build"
  },
  "keywords": [
    "uxiu-template-default",
    "uxiu-cli",
    "uxiu"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fy-store/uxiu-template-default.git"
  },
  "author": "feiYu <feiyucode@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@koa/send": "^6.0.0",
    "koa": "^3.2.1",
    "mime": "^4.1.0",
    "uxiu": "^0.22.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "uxiu-cli": "0.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
